{
  "compilerOptions": {
    "target": "ES2022",
    // DOM lib is for typing only (ambient types like DOMParser/BufferSource that some
    // shared utility files reference, guarded by feature-detection at runtime); this
    // package never runs in a browser.
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node", "vitest/globals"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "baseUrl": "../..",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
